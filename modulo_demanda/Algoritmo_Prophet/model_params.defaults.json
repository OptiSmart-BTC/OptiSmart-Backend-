{
  "global": {
    "router_mode": "auto"
  },
  "router": {
    "router_fallback": ["arima", "prophet", "tsb", "croston"],
    "dfu_recommendations": {},
    "dfu_selected_models": {},
    "router_source_collection": ""
  },
  "arima": {
    "auto": true,
    "two_stage": true,
    "use_seasonal": true,
    "max_p": 2,
    "max_q": 2,
    "max_d": 1,
    "seasonal_P_candidates": [0],
    "seasonal_D_candidates": [0, 1],
    "seasonal_Q_candidates": [0, 1],
    "maxiter_search": 12,
    "maxiter_final": 60,
    "search_budget_sec": 90,
    "fit_method": "lbfgs",
    "enforce_stationarity": true,
    "enforce_invertibility": true
  },

  "prophet": {
    "enable_tuning": true,
    "n_trials": 5,
    "add_mx_holidays": true,
    "add_monthly_seasonality": true,
    "add_quarterly_seasonality": true,
    "add_calendar_regressors": true,

    "n_changepoints": 25,
    "changepoint_prior_scale": 0.05,
    "seasonality_prior_scale": 10.0
  },

  "croston": {
    "alpha": 0.1,
    "min_occurrences": 2
  },

  "tsb": {
    "alpha": 0.1,
    "beta": 0.1,
    "min_occurrences": 2,
    "future_strategy": "constant"
  }
}